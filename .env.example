# ==========================================
# Organ Transplant Management System (OTMS)
# Environment Configuration Template
# ==========================================

# Database Connection (MongoDB Replica Set)
DATABASE_URL=mongodb://localhost:27017/organ_transplant?replicaSet=rs0

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret (Replace with a strong 256-bit random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
